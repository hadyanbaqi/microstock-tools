# Kunci rahasia untuk MCP Claude (min. 24 karakter acak). URL konektor: https://<situs>/api/mcp?key=<MCP_SECRET>
MCP_SECRET=
# Opsional tapi disarankan: kunci enkripsi terpisah untuk token/key yang disimpan (acak, 32+ karakter), supaya MCP_SECRET
# (yang ada di URL konektor dan log akses) bukan kunci utama. Data lama tetap terbaca.
ENC_KEY=
# Opsional: rahasia tambahan untuk menandatangani cookie login (acak). Mengubahnya mengeluarkan semua perangkat.
SESSION_SECRET=
# Token Apify yang dipakai MCP (kosong = memakai APIFY_TOKEN). Batas pencarian baru per hari lewat MCP.
MCP_APIFY_TOKEN=
MCP_DAILY_LIMIT=30

# Ambil di https://console.apify.com/settings/integrations
# Kosongkan untuk mode demo (data contoh).
APIFY_TOKEN=
CACHE_TTL_HOURS=48
# Maks. pencarian berbayar (tanpa cache) per IP per jam. 0 = tanpa batas.
RATE_LIMIT_PER_HOUR=20
# Maks. pencarian per IP per jam dengan token Apify milik pengunjung (mereka yang bayar; ini melindungi waktu server).
USER_LIMIT_PER_HOUR=120

# Tren Keyword storage (optional; without it trends are saved to a local file in .cache/).
# Server only: never expose the secret key to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Trend scans per IP per day when not paid with the user's own token.
SCAN_LIMIT_PER_DAY=3

# Studio Motion "Buat dengan AI" (Claude API, server only). Optional model override.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
